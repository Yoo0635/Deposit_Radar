# Backend (FastAPI)
APP_ENV=local
APP_NAME=deposit_radar
APP_HOST=0.0.0.0
APP_PORT=8000

# Security
SECRET_KEY=change_me_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=deposit_radar
DB_USER=deposit_radar
DB_PASSWORD=change_me

# OCR / File Storage
FILE_STORAGE_DIR=./storage
OCR_ENGINE=easyocr

# LLM / Playbook 엔진 (선택)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=change_me

